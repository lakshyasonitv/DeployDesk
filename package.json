{
  "name": "talentvibes-bench-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed/run.ts",
    "test": "vitest run --config vitest.config.ts",
    "db:verify": "tsx --env-file=.env.local src/db/seed/verify.ts",
    "test:leak": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/leak",
    "db:apply": "tsx --env-file=.env.local src/db/apply-sql.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "lucide-react": "^1.52.0",
    "next": "15.5.27",
    "postgres": "^3.4.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
