# Supabase — app runtime uses the Supavisor TRANSACTION pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations and seeding use the DIRECT connection (port 5432)
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Server-side pepper for identity hashing. Never commit a real value.
IDENTITY_PEPPER=dev-only-change-me
# Seed reference clock. Fixture offsets are computed from this; defaults to now.
SEED_NOW=
